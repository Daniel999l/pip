# Token contract address (the token holders burn to teach). Leave empty until the token exists.
TOKEN_ADDRESS=
# Address of the deployed Brain contract (printed by npm run deploy).
BRAIN_ADDRESS=
# Private key of the teacher wallet. It pays the gas for every lesson, so keep it funded and secret.
TEACHER_PRIVATE_KEY=
# MongoDB connection string (stores the lesson queue and history in its own database).
MONGODB_URI=
# Link to the public code repo, shown on the site. Leave empty until the repo is public.
GITHUB_URL=
# Optional: wallet that receives trading fees, and the percent of new fees to forward to the teacher wallet.
FEE_WALLET_PRIVATE_KEY=
FEED_PERCENT=
